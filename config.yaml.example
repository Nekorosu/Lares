listen: "127.0.0.1:8090"
base_url: "https://files.example.duckdns.org"

data_dir: "/srv/media/fileshare/data"
tmp_dir: "/srv/media/fileshare/tmp"
db_path: "/srv/media/fileshare/db/homeshare.db"
backup_dir: "/home/fileshare-backup"
log_dir: "/var/log/homeshare"
security_log: "/var/log/homeshare/security.log"

local_cidr: "192.168.32.0/24"

secrets:
  session_secret: "AUTO_GENERATED_SECRET_KEY_CHANGE_IN_PRODUCTION"
  ip_hash_salt: "AUTO_GENERATED_IP_SALT_CHANGE_IN_PRODUCTION"

storage_defaults:
  quota_bytes: 107374182400 # 100 GB
  monthly_upload_limit: 214748364800 # 200 GB
  monthly_download_limit: 322122547200 # 300 GB
  max_file_size: 53687091200 # 50 GB
  max_concurrent_uploads: 1
  default_expiry_days: 14
  allow_user_keep_forever: false
  quarantine_suspicious: true

speed_limits:
  external_upload_mbps: 250
  external_download_mbps: 250
  burst_mb: 16

zip_limits:
  max_files: 100
  max_total_gb: 50

session_defaults:
  user_idle_days: 30
  user_absolute_days: 90
  admin_idle_hours: 12
  admin_absolute_days: 7

disk_reserve:
  min_free_space_gb: 40
  critical_free_space_gb: 20
  min_free_inodes: 100000

suspicious_extensions:
  - exe
  - msi
  - msp
  - bat
  - cmd
  - com
  - scr
  - vbs
  - vbe
  - js
  - jse
  - ws
  - wsf
  - wsh
  - ps1
  - psm1
  - sh
  - bash
  - dll
  - ocx
  - jar
  - apk
  - hta
  - cpl
