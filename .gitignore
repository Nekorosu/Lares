```gitignore
# Dependencies
node_modules/
.pnpm-store/
.yarn/
.yarn-cache/

# Build outputs
dist/
build/
coverage/
.nyc_output/
.eslintcache

# Environment variables
.env
.env.local
.env.*
!.env.example

# IDE specific
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS generated
.DS_Store
Thumbs.db

# Logs
*.log

# Python specific (if applicable)
__pycache__/
*.pyc
*.pyo
.Python
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Node.js specific (if applicable)
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled JavaScript
*.js.map
*.jsx.map
*.ts.map
*.tsx.map

# Testing
.jest/
coverage/

# Local configuration
local.properties
```