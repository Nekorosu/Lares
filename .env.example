# Optional process environment. The application does not load .env files implicitly.
# LARES_CONFIG=/etc/homeshare/config.yaml
# LARES_SESSION_SECRET=<at least 32 random characters; keep stable across restarts>
# LARES_IP_SALT=<at least 32 random characters; keep stable across restarts>
# Prefer `homeshare config init` to generate the protected YAML once.
