# Lares Environment Variables
# Можно задать секреты через переменные окружения вместо config.yaml

# LARES_SESSION_SECRET: секрет для подписи сессионных cookie
# LARES_SESSION_SECRET="your-random-64-char-secret"

# LARES_IP_SALT: соль для хэширования IP-адресов в audit log
# LARES_IP_SALT="your-random-salt"

# NODE_ENV: production / development
NODE_ENV="development"
